{
  "schema_version": 1,
  "description": "Canonical agent-facing Gommage command contract. Commands are executed in order by scripts/check-agent-command-contracts.sh.",
  "placeholders": {
    "{report_bundle}": "Temporary JSON output path provided by the contract test.",
    "{project_root}": "Temporary project root provided by the contract test.",
    "{replay_audit}": "Temporary audit JSONL fixture provided by the contract test.",
    "{replay_policy}": "Temporary policy directory fixture provided by the contract test.",
    "{policy_diff_from}": "Temporary baseline policy directory fixture provided by the contract test.",
    "{policy_diff_to}": "Temporary candidate policy directory fixture provided by the contract test."
  },
  "commands": [
    {
      "id": "init",
      "purpose": "Initialize the selected Gommage home.",
      "stdin_mode": "none",
      "argv": ["init"]
    },
    {
      "id": "policy_init_stdlib",
      "purpose": "Install bundled policies and capability mappers.",
      "stdin_mode": "none",
      "argv": ["policy", "init", "--stdlib"]
    },
    {
      "id": "policy_init_strict_cleanup",
      "purpose": "Restore bundled policy files and remove known local allow relaxation layers with backups.",
      "stdin_mode": "none",
      "argv": [
        "policy",
        "init",
        "--stdlib",
        "--force",
        "--remove-local-relaxations"
      ]
    },
    {
      "id": "hook_decision_json",
      "purpose": "Evaluate one PreToolUse hook payload through the canonical hook adapter.",
      "stdin_mode": "json",
      "stdin_json": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": { "command": "ls" }
      },
      "argv": ["hook", "--agent", "claude"]
    },
    {
      "id": "hook_codex_ask_deny_json",
      "purpose": "Evaluate a picto-required PreToolUse hook payload with Codex-safe deny semantics.",
      "stdin_mode": "json",
      "stdin_json": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": { "command": "git push origin main" }
      },
      "argv": ["hook", "--agent", "codex"]
    },
    {
      "id": "quickstart_dry_run_json",
      "purpose": "Inspect setup mutations without writing files.",
      "stdin_mode": "none",
      "argv": [
        "quickstart",
        "--agent",
        "claude",
        "--daemon",
        "--daemon-manager",
        "systemd",
        "--dry-run",
        "--json"
      ]
    },
    {
      "id": "quickstart_dry_run_explain",
      "purpose": "Print setup posture and boundaries without writing files.",
      "stdin_mode": "none",
      "argv": ["quickstart", "--agent", "claude", "--dry-run", "--explain"]
    },
    {
      "id": "harness_diagnose_json",
      "purpose": "Inspect host hooks, local coverage boundaries, native imports, and next commands without installing anything.",
      "stdin_mode": "none",
      "argv": ["harness", "diagnose", "--json"]
    },
    {
      "id": "harness_explain_json",
      "purpose": "Emit the local harness setup context in agent-readable JSON.",
      "stdin_mode": "none",
      "argv": ["harness", "explain", "--json"]
    },
    {
      "id": "harness_write_context_dry_run",
      "purpose": "Inspect generated AGENT_CONTEXT.md and integration-report.json writes without mutating GOMMAGE_HOME.",
      "stdin_mode": "none",
      "argv": ["harness", "write-context", "--dry-run"]
    },
    {
      "id": "quickstart_claude",
      "purpose": "Install Claude Code hooks and native permission imports.",
      "stdin_mode": "none",
      "argv": ["quickstart", "--agent", "claude", "--no-self-test"]
    },
    {
      "id": "agent_install_codex",
      "purpose": "Install Codex hook wiring.",
      "stdin_mode": "none",
      "argv": ["agent", "install", "codex"]
    },
    {
      "id": "verify_json",
      "purpose": "Run the default readiness gate.",
      "stdin_mode": "none",
      "argv": ["verify", "--json"]
    },
    {
      "id": "beta_check_json",
      "purpose": "Run the beta-readiness gate for local agents and policies.",
      "stdin_mode": "none",
      "argv": ["beta", "check", "--json"]
    },
    {
      "id": "upgrade_dry_run",
      "purpose": "Inspect the release-verifying installer command that would upgrade Gommage binaries.",
      "stdin_mode": "none",
      "argv": ["upgrade", "--dry-run", "--no-prompt"]
    },
    {
      "id": "upgrade_skill_only_dry_run",
      "purpose": "Inspect a skill-only refresh for Codex and Claude Code without mutating files.",
      "stdin_mode": "none",
      "argv": [
        "upgrade",
        "--dry-run",
        "--skill-only",
        "--skill-agent",
        "codex",
        "--skill-agent",
        "claude",
        "--no-prompt"
      ]
    },
    {
      "id": "beta_check_policy_fixture_json",
      "purpose": "Run the beta-readiness gate with repository-owned policy fixtures.",
      "stdin_mode": "none",
      "argv": [
        "beta",
        "check",
        "--json",
        "--policy-test",
        "examples/policy-fixtures.yaml"
      ]
    },
    {
      "id": "verify_policy_fixtures",
      "purpose": "Run repository-owned policy fixtures.",
      "stdin_mode": "none",
      "argv": ["verify", "--json", "--policy-test", "examples/policy-fixtures.yaml"]
    },
    {
      "id": "report_bundle",
      "purpose": "Create a redacted support bundle.",
      "stdin_mode": "none",
      "argv": ["report", "bundle", "--redact", "--output", "{report_bundle}"]
    },
    {
      "id": "doctor_json",
      "purpose": "Inspect lower-level runtime health.",
      "stdin_mode": "none",
      "argv": ["doctor", "--json"]
    },
    {
      "id": "agent_status_claude",
      "purpose": "Inspect Claude Code hook and permission import state.",
      "stdin_mode": "none",
      "argv": ["agent", "status", "claude", "--json"]
    },
    {
      "id": "agent_status_codex",
      "purpose": "Inspect Codex hook and sandbox state.",
      "stdin_mode": "none",
      "argv": ["agent", "status", "codex", "--json"]
    },
    {
      "id": "posture_json",
      "purpose": "Compare the active local policy posture against bundled strict stdlib semantics.",
      "stdin_mode": "none",
      "argv": ["posture", "--json"]
    },
    {
      "id": "session_doctor_json",
      "purpose": "Inspect live or injected agent sessions and whether their homes are Gommage-wired.",
      "stdin_mode": "none",
      "argv": ["session", "doctor", "--json"]
    },
    {
      "id": "managed_status_json",
      "purpose": "Inspect shipped user-mode deployment signals, hook integrity, bypass posture, and the explicit lack of isolation from the current UID.",
      "stdin_mode": "none",
      "argv": ["managed", "status", "--json"]
    },
    {
      "id": "run_codex_dry_run_json",
      "purpose": "Build a verified Codex launch plan without executing Codex.",
      "stdin_mode": "none",
      "argv": [
        "run",
        "codex",
        "--dry-run",
        "--json",
        "--sandbox",
        "workspace-write",
        "--",
        "contract"
      ]
    },
    {
      "id": "smoke_json",
      "purpose": "Run built-in semantic policy checks.",
      "stdin_mode": "none",
      "argv": ["smoke", "--json"]
    },
    {
      "id": "stats_json",
      "purpose": "Aggregate audit, approval, friction, deny-loop, and watchlist telemetry.",
      "stdin_mode": "none",
      "argv": ["stats", "--json"]
    },
    {
      "id": "sandbox_advise_json",
      "purpose": "Print advisory native sandbox bridge guidance.",
      "stdin_mode": "none",
      "argv": ["sandbox", "advise", "--json"]
    },
    {
      "id": "replay_json",
      "purpose": "Replay historical audit decisions against a candidate policy.",
      "stdin_mode": "none",
      "argv": [
        "replay",
        "--audit",
        "{replay_audit}",
        "--policy",
        "{replay_policy}",
        "--json"
      ]
    },
    {
      "id": "policy_diff_json",
      "purpose": "Compare two policy directories against historical audit decisions.",
      "stdin_mode": "none",
      "argv": [
        "policy",
        "diff",
        "--from",
        "{policy_diff_from}",
        "--to",
        "{policy_diff_to}",
        "--against",
        "{replay_audit}",
        "--json"
      ]
    },
    {
      "id": "policy_suggest_json",
      "purpose": "Generate advisory policy rule and fixture drafts for uncovered audit decisions.",
      "stdin_mode": "none",
      "argv": ["policy", "suggest", "--audit", "{replay_audit}", "--json"]
    },
    {
      "id": "tui_snapshot_all",
      "purpose": "Capture the human operator snapshot without ANSI output.",
      "stdin_mode": "none",
      "argv": ["tui", "--snapshot", "--view", "all"]
    },
    {
      "id": "tui_snapshot_onboarding",
      "purpose": "Capture first-minute operator setup and rollback guidance.",
      "stdin_mode": "none",
      "argv": ["tui", "--snapshot", "--view", "onboarding"]
    },
    {
      "id": "tui_snapshot_approvals",
      "purpose": "Capture the approval inbox operator snapshot without ANSI output.",
      "stdin_mode": "none",
      "argv": ["tui", "--snapshot", "--view", "approvals"]
    },
    {
      "id": "tui_snapshot_metrics",
      "purpose": "Capture local operator metrics, daemon health, and picto inventory without ANSI output.",
      "stdin_mode": "none",
      "argv": ["tui", "--snapshot", "--view", "metrics"]
    },
    {
      "id": "tui_watch_approvals",
      "purpose": "Capture bounded approval inbox refresh frames without ANSI output.",
      "stdin_mode": "none",
      "argv": [
        "tui",
        "--watch",
        "--watch-ticks",
        "2",
        "--refresh-ms",
        "250",
        "--view",
        "approvals"
      ]
    },
    {
      "id": "tui_stream_decisions",
      "purpose": "Capture bounded live decision stream frames without ANSI output.",
      "stdin_mode": "none",
      "argv": [
        "tui",
        "--stream",
        "--stream-ticks",
        "1",
        "--stream-limit",
        "8",
        "--refresh-ms",
        "250"
      ]
    },
    {
      "id": "approval_list_json",
      "purpose": "Inspect pending out-of-band approval requests.",
      "stdin_mode": "none",
      "argv": ["approval", "list", "--json"]
    },
    {
      "id": "approval_deny_stale_dry_run_json",
      "purpose": "Inspect stale pending approval requests without mutating approval state.",
      "stdin_mode": "none",
      "argv": ["approval", "deny-stale", "--older-than", "24h", "--json"]
    },
    {
      "id": "approval_dlq_json",
      "purpose": "Inspect dead-lettered approval webhook deliveries.",
      "stdin_mode": "none",
      "argv": ["approval", "dlq", "--json"]
    },
    {
      "id": "approval_webhook_dry_run_json",
      "purpose": "Render pending approval webhook payloads without network delivery.",
      "stdin_mode": "none",
      "argv": [
        "approval",
        "webhook",
        "--url",
        "https://approval.example.invalid/hook",
        "--dry-run",
        "--json"
      ]
    },
    {
      "id": "approval_webhook_signed_dry_run_json",
      "purpose": "Render a signed generic approval webhook payload without network delivery.",
      "stdin_mode": "none",
      "argv": [
        "approval",
        "webhook",
        "--url",
        "https://approval.example.invalid/hook",
        "--dry-run",
        "--json",
        "--signing-secret",
        "contract-secret",
        "--signing-key-id",
        "contract"
      ]
    },
    {
      "id": "approval_webhook_slack_dry_run_json",
      "purpose": "Render Slack-shaped pending approval webhook payloads without network delivery.",
      "stdin_mode": "none",
      "argv": [
        "approval",
        "webhook",
        "--provider",
        "slack",
        "--url",
        "https://approval.example.invalid/slack",
        "--dry-run",
        "--json"
      ]
    },
    {
      "id": "approval_webhook_discord_dry_run_json",
      "purpose": "Render Discord-shaped pending approval webhook payloads without network delivery.",
      "stdin_mode": "none",
      "argv": [
        "approval",
        "webhook",
        "--provider",
        "discord",
        "--url",
        "https://approval.example.invalid/discord",
        "--dry-run",
        "--json"
      ]
    },
    {
      "id": "approval_template_ntfy_json",
      "purpose": "Print the ntfy approval notification template without sending.",
      "stdin_mode": "none",
      "argv": ["approval", "template", "--provider", "ntfy", "--json"]
    },
    {
      "id": "policy_schema",
      "purpose": "Print the fixture schema for agents/editors/CI.",
      "stdin_mode": "none",
      "argv": ["policy", "schema"]
    },
    {
      "id": "policy_check",
      "purpose": "Validate active policy files.",
      "stdin_mode": "none",
      "argv": ["policy", "check"]
    },
    {
      "id": "policy_layers_json",
      "purpose": "Inspect active policy layer order and effective policy hash.",
      "stdin_mode": "none",
      "argv": ["policy", "layers", "--json"]
    },
    {
      "id": "policy_lint_strict_json",
      "purpose": "Run strict policy authoring checks against the active policy directory.",
      "stdin_mode": "none",
      "argv": ["policy", "lint", "--strict", "--json"]
    },
    {
      "id": "policy_test_json",
      "purpose": "Run a fixture file directly.",
      "stdin_mode": "none",
      "argv": ["policy", "test", "examples/policy-fixtures.yaml", "--json"]
    },
    {
      "id": "project_init_dry_run_json",
      "purpose": "Inspect project-local policy starter files without writing them.",
      "stdin_mode": "none",
      "argv": ["project", "init", "--root", "{project_root}", "--dry-run", "--json"]
    },
    {
      "id": "map_json",
      "purpose": "Inspect capability mapping for a ToolCall.",
      "stdin_mode": "json",
      "stdin_json": {
        "tool": "Bash",
        "input": {
          "command": "git push --force origin main"
        }
      },
      "argv": ["map", "--json"]
    },
    {
      "id": "map_hook_json",
      "purpose": "Inspect capability mapping for a PreToolUse hook payload.",
      "stdin_mode": "json",
      "stdin_json": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "git push --force origin main"
        }
      },
      "argv": ["map", "--json", "--hook"]
    },
    {
      "id": "grant_creates_audit_event",
      "purpose": "Verify picto creation and audit-event write path.",
      "stdin_mode": "none",
      "argv": [
        "grant",
        "--scope",
        "test.contract",
        "--uses",
        "1",
        "--ttl",
        "60",
        "--reason",
        "contract"
      ]
    },
    {
      "id": "audit_verify_explain",
      "purpose": "Verify signed audit logs with automation JSON.",
      "stdin_mode": "none",
      "argv": ["audit-verify", "--explain", "--json"]
    },
    {
      "id": "state_rebuild_json",
      "purpose": "Rebuild the local SQLite state read-model from the available authenticated audit records.",
      "stdin_mode": "none",
      "argv": ["state", "rebuild", "--json"]
    },
    {
      "id": "state_verify_json",
      "purpose": "Verify whether state.sqlite matches the current audit log snapshot.",
      "stdin_mode": "none",
      "argv": ["state", "verify", "--json"]
    },
    {
      "id": "state_stats_json",
      "purpose": "Read fast local audit counters from state.sqlite.",
      "stdin_mode": "none",
      "argv": ["state", "stats", "--json"]
    },
    {
      "id": "state_vacuum",
      "purpose": "Vacuum the rebuildable SQLite state read-model.",
      "stdin_mode": "none",
      "argv": ["state", "vacuum"]
    },
    {
      "id": "state_reset_dry_run",
      "purpose": "Inspect rebuildable state index removal without touching audit evidence.",
      "stdin_mode": "none",
      "argv": ["state", "reset", "--dry-run"]
    },
    {
      "id": "agent_uninstall_dry_run",
      "purpose": "Inspect reversible agent hook cleanup.",
      "stdin_mode": "none",
      "argv": ["agent", "uninstall", "all", "--restore-backup", "--dry-run"]
    },
    {
      "id": "repair_agent_dry_run",
      "purpose": "Inspect legacy or broken agent hook repair without mutating host config.",
      "stdin_mode": "none",
      "argv": ["repair", "agent", "all", "--dry-run"]
    },
    {
      "id": "uninstall_dry_run",
      "purpose": "Inspect full cleanup without mutating state.",
      "stdin_mode": "none",
      "argv": ["uninstall", "--all", "--dry-run", "--daemon-manager", "systemd"]
    }
  ]
}
